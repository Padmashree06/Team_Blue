{
  "name": "securemcp",
  "displayName": "SecureMCP",
  "description": "Connects VS Code to AI agents (OpenAI, Claude, Copilot) over a secured, sandboxed MCP server",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.132.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "securemcp.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "mcpAgentSecurity.connect",
        "title": "MCP Agent Security: Connect"
      },
      {
        "command": "mcpAgentSecurity.disconnect",
        "title": "MCP Agent Security: Disconnect"
      },
      {
        "command": "mcpAgentSecurity.showLogs",
        "title": "MCP Agent Security: Show Logs"
      }
    ]
  },
  "configuration": {
      "title": "MCP Agent Security",
      "properties": {
        "mcpAgentSecurity.serverCommand": {
          "type": "string",
          "default": "python3",
          "description": "Command used to launch the Python MCP server."
        },
        "mcpAgentSecurity.serverArgs": {
          "type": "array",
          "default": ["-m", "mcp_server"],
          "description": "Arguments passed to the MCP server command."
        },
        "mcpAgentSecurity.activeAgent": {
          "type": "string",
          "enum": ["openai", "anthropic", "copilot"],
          "default": "anthropic",
          "description": "Which agent provider is active."
        }
      }
    },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
